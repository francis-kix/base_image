# central version manifest (borrowed from container-xy hub.yaml idea)
# single source of truth for third-party pieces baked into the image

# openresty apt distribution component (openresty.org has no sid/trixie yet)
OPENRESTY_DIST=bookworm

# sury.org php apt distribution
SURY_DIST=bookworm

# webgrind release tag (profiler viewer)
WEBGRIND_VERSION=v1.9.4
